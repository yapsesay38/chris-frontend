---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Nav from '../components/Nav.astro'
import '../styles/global.css'
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
    <link rel="icon" href="/dacarlogo_ico/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Cordillera Heirloom Rice Information System</title>
    <script>
      document.addEventListener('alpine:init', () => {
        Alpine.data('hamburgerMenu', () => ({
          isOpen: false,
          toggle() {
            this.isOpen = !this.isOpen;
          }
        }));
      });
    </script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
	</head>
  <body>
    <div class="container"
         x-data="hamburgerMenu()"
         >
      <div class="header">
        <Header />
        <button class="hamburger"
                @click="toggle()"
                :class="{ 'is-active': isOpen }"
                aria-label="Toggle navigation"
                >
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>
      </div>
      <div class="backdrop"
           x-show="isOpen"
           @click="isOpen = false"
           x-cloak
           >
      </div>
      <div class="sidebar"
           :class="{ 'nav-open': isOpen }"
           >
        <Nav />
      </div>
      <div class="dash">
        <div class="hnav">
          <slot name="hnav"/>
        </div>
        <main>
          <div class="content">
            <slot name="content"/>
          </div>
        </main>
      </div>
    </div>
    <Footer />
	</body>
</html>

<style>
  .container {
    margin: 0 auto;
  }

  main {
    max-width: 800px;
  }

  @media (min-width: 1400px) {
    .container {
      min-width: 1400px;
    }
  
    main {
      min-width: 900px;
    }
  }
</style>
