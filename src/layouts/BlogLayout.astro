---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Nav from '../components/Nav.astro'
import '../styles/global.css'
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
    <link rel="icon" href="/dacarlogo_ico/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Cordillera Heirloom Rice Information System</title>
	</head>
	<body>
    <div class="container" x-data="{ sidebarOpen: false }">
      <div class="header">
        <Header />
        <button class="hamburger"
                @click="navOpen = !navOpen"
                :class="{ 'is-active':navOpen }"
                aria-label="Toggle navigation"
                >
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>
      </div>
      <div class="sidebar" :class="{ 'nav-open': navOpen }" @click.away="navOpen = false">
        <Nav />
      </div>
      <div class="dash">
        <div class="hnav">
          <slot name="hnav"/>
        </div>
        <main>
          <div class="content">
            <slot name="content"/>
          </div>
        </main>
      </div>
    </div>
    <Footer />
	</body>
</html>
