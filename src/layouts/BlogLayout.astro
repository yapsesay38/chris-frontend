---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Nav from '../components/Nav.astro'
import '../styles/global.css'
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
    <link rel="icon" href="/dacarlogo_ico/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<title>Cordillera Heirloom Rice Information System</title>
	</head>
	<body>
    <div class="container">
      <div class="sidebar">
        <Header />
        <Nav />
      </div>
      <div class=dash>
        <main>
          <div class="content">
            <slot name="content"/>
          </div>
        </main>
      </div>
    </div>
    <Footer />
	</body>
</html>

<style>
  .container {
    display: flex;
    flex-wrap: nowrap;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    gap: 0.5rem;
    width: 100%;
  }

  .sidebar {
    flex: 0 0 220px;
    padding: 10px 0;
  }

  main {
    max-width: 800px;
    margin: 0 auto;
    padding: 1.5rem;
    background-color: #ffffff;
    border-top: 1px solid #c9c9c9;
    border-left: 1px solid #c9c9c9;
    border-radius: 0.5rem;
    min-height: 100vh;
  }

  .content {
    margin: 2px;
  }

  .dash {
    flex: 1;
    min-width: 0;
  }
</style>
