---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Nav from '../components/Nav.astro'
import '../styles/global.css'
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
    <link rel="icon" href="/dacarlogo_ico/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<title>Astro</title>
	</head>
	<body>
    <div class="container">
      <div class="sidebar">
        <Header />
        <Nav />
      </div>
      <div class=dash>
        <div class="hnav">
          <slot name="hnav"/>
        </div>
        <main>
          <div class="content">
            <slot name="content"/>
          </div>
        </main>
      </div>
    </div>
    <Footer />
	</body>
</html>

<style>
  .container {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
  }

  .sidebar {
    display: flex;
    flex-direction: column;
    width: 15%;
    padding: 10px 0;
  }

  main {
    flex: 1;
    margin: 15px 10px;
    padding: 0px;
    border-top: 1px solid #c9c9c9;
    border-left: 1px solid #c9c9c9;
    border-radius: 0.5rem;
    width: 100%;
    min-height: 100vh;
    background-color: #ffffff;
  }

  .content {
    margin: 25px;
  }

  .dash {
    width: 83vw;
  }
</style>
