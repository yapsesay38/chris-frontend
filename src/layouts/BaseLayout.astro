---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Nav from '../components/Nav.astro'
import '../styles/global.css'
---

<html lang="en">
	<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
		<title>Cordillera Heirloom Rice Information System</title>
    <meta name="description" content="Cordillera Heirloom Rice Information System." />

    <link rel="icon" type="image/svg+xml" href="/dacarlogo/favicon.svg">
    <link rel="icon" type="image/png" sizes="96x96" href="/dacarlogo/favicon-96x96.png">
    <link rel="icon" type="image/x-icon" href="/dacarlogo/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/dacarlogo_ico/apple-touch-icon.png">

    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="CHRIS" />
    <script>
      document.addEventListener('alpine:init', () => {
        Alpine.data('hamburgerMenu', () => ({
          isOpen: false,
          toggle() {
            this.isOpen = !this.isOpen;
          }
        }));
      });
    </script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
	</head>
	<body>
    <div class="container"
         x-data="hamburgerMenu()"
         >
      <div class="header">
        <Header />
        <button class="hamburger"
                @click="toggle()"
                :class="{ 'is-active': isOpen }"
                aria-label="Toggle navigation"
                >
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>
      </div>
      <div class="backdrop"
           x-show="isOpen"
           @click="isOpen = false"
           x-cloak
           >
      </div>
      <div class="sidebar"
           :class="{ 'nav-open': isOpen }"
           >
        <Nav />
      </div>
      <div class="dash">
        <div class="hnav">
          <slot name="hnav"/>
        </div>
        <main>
          <div class="content">
            <slot name="content"/>
          </div>
        </main>
      </div>
    </div>
    <Footer />
	</body>
</html>

<style>
  main {
    width: 100%;
  }

  .container {
    margin: 0;
    width: 100%;
  }
</style>
