---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Nav from '../components/Nav.astro'
import '../styles/global.css'
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
    <link rel="icon" href="/dacarlogo_ico/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Cordillera Heirloom Rice Information System</title>
	</head>
	<body>
    <div class="container">
      <div class="sidebar">
        <Header />
        <Nav />
      </div>
      <div class=dash>
        <div class="hnav">
          <slot name="hnav"/>
        </div>
        <main>
          <div class="content">
            <slot name="content"/>
          </div>
        </main>
      </div>
    </div>
    <Footer />
	</body>
</html>

<style>
  .hnav {
    max-width: 800px;
    margin: 0 auto;
  }
</style>
