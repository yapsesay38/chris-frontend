---
import Logo from '../components/Logo.astro';
---

<header id="header">
  <div id="logo">
    <Logo />
  </div>
  <div id="header-text">
    <h1>Cordillera Heirloom Rice Information System</h1>
  </div>
</header>

<style>
  #header {
    position: relative;
    text-align: center;
  }

  #logo {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
  }

  #header-text {
    text-align: center;
  }

</style>
