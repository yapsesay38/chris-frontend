---
import NavLink from '../components/NavLink.astro'

import { locations, pages } from '../data/navigation.js';

const { location } = Astro.params;
const currentLocation = locations.find(loc => loc.location === location);
---

<NavLink href={`/${currentLocation?.location}/hrProfile`} type="table">HR Tables</NavLink>
{pages.map(p => (
  <NavLink href={`/${currentLocation?.location}/${p.page}`} type="page">{p.name}</NavLink>
))}
<NavLink href={`/inputApp/form.html?province=${currentLocation?.name}`} type="form">Input</NavLink>

<style>
  a {
    display: inline-block;
    color: #165871;
    margin: 10px;
    padding: 8px 16px;
    text-decoration: none;
    border-radius: 0.5rem;
  }
</style>
