---
import NavLink from '../components/NavLink.astro'

import { pages, tables } from '../data/navigation.js';
const { currentLocation } = Astro.props;
---

<NavLink href={`/${currentLocation}/hrProfile/${tables[0].table}`} type="table">HRProfile</NavLink>
{pages.map(p => (
  <NavLink href={`/${currentLocation}/${p.page}`} type="page">{p.name}</NavLink>
))}

<style>
  a {
    display: inline-block;
    color: #165871;
    margin: 10px;
    padding: 8px 16px;
    text-decoration: none;
    border-radius: 0.5rem;
  }
</style>
