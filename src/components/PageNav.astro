---
import NavLink from '../components/NavLink.astro'

import { pages } from '../data/navigation.js';
const { currentLocation } = Astro.props;
---

{pages.map(page => (
  <NavLink href={`/${currentLocation}/${page.slug}`}>{page.name}</NavLink>
))}

<style>
  a {
    display: inline-block;
    color: #165871;
    margin: 10px;
    padding: 8px 16px;
    text-decoration: none;
    border-radius: 0.5rem;
  }

  a:hover {
    color: #ede78d;
    background-color: #165871e6;
  }

  a.active {
    color: #ede78d;
    background-color: #165871;
  }
</style>
