---
import { Image } from 'astro:assets';
import daphlogo from '../assets/daphlogo.png';
import contacticon from '../assets/ContactIcon.png';
import emailicon from '../assets/EmailIcon.png';
---

<footer>
  <ul>
    <li><a href="https://car.da.gov.ph/">
        <Image
            src={daphlogo}
            alt="darfocar logo"
            width={32}
            height={32}
        /><span>DEPARTMENT OF AGRICULTURE - CAR</span></a>
    </li>
    <li><Image
            src={contacticon}
            alt="darfocar logo"
            width={32}
            height={32}
        /><span>+63 907 1333 091</span></li>
    <li><Image
            src={emailicon}
            alt="darfocar logo"
            width={32}
            height={32}
        /><span>resd@da.car.gov.ph</span></li>
  </ul>
  <iframe 
    src="//gwhs.i.gov.ph/gwt-footer/footer-source.html"
    id="footer-gwt-frame"
    loading="lazy"
    width="100%"
    scrolling="no"
    style="border: 0px; min-height: 188px; margin-bottom: -3px; overflow: hidden; height: 193px;"
    >
  </iframe>
</footer>

<style>
  footer {
    margin-top: auto;
    background-color: #165871;
    width: 100vw;
  }

  ul {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    width: 100%;
    list-style: none;
    font-size: 17px;
    padding: 0;
    margin: 8px;
  }

  li, li a{
    display: flex;
    align-items: center;
    color: #ffffff;
    text-decoration: none;
    gap: 0.5rem;
  }

  li:not(:last-child)::after {
    content: "|";
    margin: 0px;
  }

  li a:hover {
    color: #ede78d;
  }
</style>
