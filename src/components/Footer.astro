---
import { Image } from 'astro:assets';
import daphlogo from '../assets/logos/daphlogo.png';
import contacticon from '../assets/comIcons/contactIcon.png';
import emailicon from '../assets/comIcons/emailIcon.png';
import rice_favicon from '../assets/rice_favicon/favicon.ico';
import NavLink from '../components/NavLink.astro';
---

<footer>
  <ul>
    <li>
      <NavLink href="https://car.da.gov.ph/">
        <Image
            src={daphlogo}
            alt="darfocar logo"
            width={32}
            height={32}
            />
        <span>Department of Agriculture - CAR</span>
      </NavLink>
    </li>
    <li>
      <Image
          src={contacticon}
          alt="contact icon"
          width={32}
          height={32}
          />
          <span>+63 907 1333 091</span>
    </li>
    <li>
      <Image
          src={emailicon}
          alt="email icon"
          width={32}
          height={32}
          />
      <span>resd@da.car.gov.ph</span>
    </li>
    <li>
      <NavLink href="/inputApp/index.html">
        <Image
            src={rice_favicon}
            alt="rice app logo"
            width={32}
            height={32}
            />
        <span>Input Rice Data</span>
      </NavLink>
    </li>
  </ul>
  <iframe 
    src="//gwhs.i.gov.ph/gwt-footer/footer-source.html"
    id="footer-gwt-frame"
    loading="lazy"
    width="100%"
    scrolling="no"
    style="border: 0px; min-height: 188px; margin-bottom: -3px; overflow: hidden; height: 193px;"
    >
  </iframe>
</footer>

<style>
  footer ul, footer li, footer a {
    margin: 0;
    padding: 0;
    border: 0;
  }

  ul {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    width: 100%;
    height: 45px;
    list-style: none;
    font-size: 17px;
    padding: 0;
    margin: 0;
  }

  li, li a {
    display: flex;
    align-items: center;
    color: #ffffff;
    text-decoration: none;
    gap: 0.5rem;
  }

  li:not(:last-child)::after {
    content: "|";
    margin: 0 0.5rem;
  }

  li a:hover {
    color: #ede78d;
  }
</style>
