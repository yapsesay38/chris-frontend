---
const { href, class: className, type, ...rest } = Astro.props;
let currentPath = Astro.url.pathname;
const isLocActive = type === 'location';

const normalizePath = (path) => path
    .replace(/\.html$/, '')
    .replace(/\/$/, '')
    .replace(/^\/index$/, '/');

const normalizedCurrent = normalizePath(currentPath);
const normalizedHref = normalizePath(href);

let isActive = false;

if (isLocActive) {
    isActive = normalizedCurrent === normalizedHref ||
               normalizedCurrent.startsWith(normalizedHref + '/') ||
               (normalizedHref !== '/' && normalizedCurrent.split('/')[1] === normalizedHref.split('/')[1]);
} else {
    isActive = normalizedCurrent === normalizedHref;
}
---

<a href={href} class:list={[{ 'active': isActive }, className]} {...rest}>
  <slot />
</a>

<style>
  a {
    display: block;
    color: #165871;
    margin: 10px;
    padding: 8px 16px;
    text-decoration: none;
    border-radius: 0.5rem;
  }

  a:hover {
    color: #ede78d;
    background-color: #165871e6;
  }

  a.active {
    color: #ede78d;
    background-color: #165871;
  }
</style>
