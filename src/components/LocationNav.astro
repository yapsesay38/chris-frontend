---
import NavLink from '../components/NavLink.astro';

import { locations, pages } from '../data/navigation.js';

const currentPath = Astro.url.pathname;

const isDropdownActive = locations.some(loc =>
  currentPath.startsWith(`/${loc.location}`)
);
---

<div class="dropdown" class:list={[{ 'is-active': isDropdownActive }]} data-active={isDropdownActive ? 'true' : 'false'}>
  <p class="dropbtn provinces-space">
  <span>CAR</span>
  <span class="arrow">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="12 5 19 12 12 19"></polyline>
    </svg>
  </span>
  </p>
  <div class="dropdown-content">
    {locations.map(loc => (
    <NavLink href={`/${loc.location}/${pages[0].page}`} type="location">{loc.name}</NavLink>
    ))}
  </div>
</div>

<style>
p {
  display: block;
  color: #165871;
  margin: 10px;
  padding: 8px 16px;
  text-decoration: none;
  border-radius: 0.5rem;
}

p:hover {
  color: #ede78d;
  background-color: #165871e6;
}

p.active {
  color: #ede78d;
  background-color: #165871;
}

.dropdown-content {
  display: none;
  min-width: 160px;
  z-index: 1;
}

.provinces-space {
  display: flex;
  justify-content: space-between;
}

.arrow {
  transform-origin: center;
  transition: transform 0.3s ease;
}

.dropdown.is-active .dropdown-content {
  display: block !important;
}

.dropdown.is-active .arrow {
    transform: rotate(90deg);
}

@media (hover: hover) and (pointer: fine) {
  .dropdown:hover .dropdown-content {
    display: block;
  }
  .dropdown:hover .arrow {
    transform: rotate(90deg);
  }

  .dropdown.closed .dropdown-content {
    display: none !important;
  }

  .dropdown.is-active .dropdown-content {
    display: block;
  }

  .dropdown.is-active .arrow {
    transform: rotate(90deg);
  }
}
</style>

<script>
  const dropdowns = document.querySelectorAll('.dropdown');
  const dropbtns = document.querySelectorAll('.dropbtn');

  const isTouchDevice = () => window.matchMedia('(pointer: coarse)').matches;

  dropbtns.forEach((btn) => {
    const parentDropdown = btn.closest('.dropdown');

    btn.addEventListener('click', function(event) {
      if (isTouchDevice()) {
        event.preventDefault();
        event.stopPropagation();

        if (parentDropdown) {
          parentDropdown.classList.toggle('is-active');
        }
      } else {
        if (parentDropdown) {
          parentDropdown.classList.add('closed');
        }
      }
    });

    if (parentDropdown) {
      parentDropdown.addEventListener('mouseleave', function() {
        if (!isTouchDevice()) {
          this.classList.remove('closed');
        }
      });
    }
  });

  document.addEventListener('click', function() {
    if (isTouchDevice()) {
      document.querySelectorAll('.dropdown.is-active').forEach(dropdown => {
        if (dropdown.dataset.active !== 'true') {
          dropdown.classList.remove('is-active');
        }
      });
    }
  });
</script>
