---
import BaseLayout from '../../layouts/BaseLayout.astro'
import NavLink from '../../components/NavLink.astro'
import PageNav from '../../components/PageNav.astro'

import { locations, pages } from '../../data/navigation.js'

export function getStaticPaths() {
  return [
    ...locations.flatMap(loc =>
       pages.map(p => ({
         params: { location: loc.location, page: p.page },
       }))
    )
  ];
}

const { location, page } = Astro.params;
const currentLocation = locations.find(loc => loc.location === location);
const currentPage = pages.find(p => p.page === page);
---

<BaseLayout>
  <nav slot="hnav">
    <PageNav currentLocation={Astro.params.location} />
  </nav>
  <div slot="content">
    <h1>{ currentPage?.name } data for { currentLocation?.name }</h1>
    <revo-grid columns={columns} source{rows}></revo-grid>
  </div>
</BaseLayout>

<style>
  nav {
    background-color: #ffffff;
    padding: 0px;
    border-radius: 0.5rem;
  }

  .active {
    background-color: #165871;
  }
</style>
