---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import NavLink from '../../../components/NavLink.astro'
import PageNav from '../../../components/PageNav.astro'
import Vigor from '../../../components/revogrid/Vigor.vue'

import { locations, tables } from '../../../data/navigation.js'

export function getStaticPaths() {
  return [
    ...locations.flatMap(loc =>
       tables.map(t => ({
         params: { location: loc.location, table: t.table },
       }))
    )
  ];
}

const { location, table } = Astro.params;
const currentLocation = locations.find(loc => loc.location === location);
const currentTable = tables.find(t => t.table === table);
---
<BaseLayout>
  <nav slot="hnav">
    <PageNav currentLocation={Astro.params.location} />
  </nav>
  <div slot="content">
    <h1>{ currentTable?.name } data for { currentLocation?.name }</h1>
    <Vigor client:load />
  </div>
</BaseLayout>

<style>
  nav {
    background-color: #ffffff;
    padding: 0px;
    border-radius: 0.5rem;
  }

  .active {
    background-color: #165871;
  }
</style>
