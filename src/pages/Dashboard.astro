---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout>
  <div slot="content">
    <h1>Heirloom Rice Dashboard</h1>
    <div id="dashboard-container" style="width: 100%; height: 800px;">
    </div>
  </div>
</BaseLayout>

<script type="module">
  import { embedDashboard } from '@superset-ui/embedded-sdk';

  async function loadDashboard() {
    try {
      const response = await fetch('/api/superset/guest-token');
      if (!response.ok) throw new Error('Failed to fetch guest token');
      const { token } = await response.json();

      embedDashboard({
        id: 'feb18f6d-8bd4-4bd8-b78b-67f4b7e48ddf',
        supersetDomain: 'http://localhost:8088',
        mountPoint: document.getElementById('dashboard-container'),
        fetchGuestToken: () => token,
        dashboardUiConfig: {
          hideTitle: false,
          hideTab: false,
          hideChartControls: false,
          filters: { expanded: true },
        },
      });
    } catch (err) {
      console.error('Dashboard embedding error:', err);
      document.getElementById('dashboard-container').innerHTML = '❌ Failed to load dashboard.';
    }
  }

  loadDashboard();
</script>
