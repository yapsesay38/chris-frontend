---
import { Image } from 'astro:assets';
import dacarlogo from '../assets/daphlogo.png';
---

<footer>
  <ul>
    <li><a href="https://car.da.gov.ph/">
        <Image
            src={dacarlogo}
            alt="darfocar logo"
            width={32}
            height={32}
        /><span> DEPARTMENT OF AGRICULTURE - CAR</span></a>
    </li>
    <li><Image
            src={dacarlogo}
            alt="darfocar logo"
            width={16}
            height={16}
        /><span> +63 907 1333 091</span></li>
    <li><Image
            src={dacarlogo}
            alt="darfocar logo"
            width={16}
            height={16}
        /><span> resd@da.car.gov.ph</span></li>
  </ul>
  <iframe 
    src="//gwhs.i.gov.ph/gwt-footer/footer-source.html"
    id="footer-gwt-frame"
    loading="lazy"
    width="100%"
    scrolling="no"
    style="border: 0px; min-height: 188px; margin-bottom: -3px; overflow: hidden; height: 193px;"
    >
  </iframe>
</footer>

<style>
  footer {
    margin-top: auto;
    background-color: #165871;
  }

  ul {
    display: flex;
    align-items: center;
    width: 95%;
    list-style: none;
    font-size: 20px;
    padding: 0;
    margin: 8px 440px;
  }

  li {
    display: inline-block;
    color: #ffffff;
  }

  li:not(:last-child)::after {
    content: "|";
    margin: 0px 10px;
  }

  li a {
    color: #ffffff;
    text-decoration: none;
  }

  li a:hover {
    color: #ede78d;
  }
</style>
